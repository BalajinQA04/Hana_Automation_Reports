                    <img class=\"desk\" src=\"https://res.cloudinary.com/dizexseir/image/upload/v1781852658/ProImages/ujn6riqqhwwukaojlua0.png\" alt=\"Hana Software\">\r\n                    \r\n                    <img class=\"mob\" src=\"https://res.cloudinary.com/dizexseir/image/upload/v1771568783/ProImages/zau7kq0d6dgpq9revnnl.png\" alt=\"Hana Software\" style=\"display:none;\">\r\n                    <div class=\"minfo\">\r\n                        <b>Need Help?</b>\r\n                        <p>For assistance with activation, setup, or login issues, call us at <a href=\"tel:503-445-3059\">503-445-3059</a> or email <a href=\"mailto:support@hanasoftware.com\">support@hanasoftware.com</a>.</p>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n    <!-- ==============Modal Popup ====================== -->\r\n    <div id=\"ModalNewSubscription\" class=\"modal fade\" role=\"dialog\">\r\n        <div class=\"modal-dialog ModalDialog\">\r\n            <!-- Modal content-->\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header ModalHeader\">\r\n                    <span class=\"modal-title\">New Subscription</span>\r\n                </div>\r\n                <div class=\"modal-body\" id=\"NewSubscribeBody\">\r\n\r\n\r\n                    <br />\r\n\r\n                    <div class=\"row hidden\" id=\"divSales\">\r\n                        <label class=\"col-md-3 col-sm-12 col-xs-12 lblMessage\">Select Sales Person Plan</label>\r\n                        <div class=\"col-md-9 text-center\">\r\n                            <select id=\"ddlSales\" class=\"form-control\"></select>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <br />\r\n\r\n                    <div class=\"row\" id=\"divNewPlan\">\r\n                        <label class=\"col-md-3 col-sm-12 col-xs-12 lblMessage\">Choose Plan</label>\r\n                        <div class=\"col-md-9 text-center\">\r\n                            <select id=\"ddlPlan\" class=\"form-control\"></select>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"modal-footer\">\r\n                    <div class=\"col-md-12 pull-right\">\r\n                        <button type=\"button\" class=\"btn btn-default\" data-dismiss=\"modal\">Close</button>\r\n                        <button type=\"button\" class=\"btn btn-primary\" id=\"btnSubscribePlan\">Subscribe</button>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n        </div>\r\n    </div>\r\n    <div id=\"ModalRenewSubscription\" class=\"modal fade\" role=\"dialog\">\r\n        <div class=\"modal-dialog\" style=\"height: 500px;\">\r\n            <!-- Modal content-->\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <button type=\"button\" class=\"close\" data-dismiss=\"modal\">&times;</button>\r\n                    <h4 class=\"modal-title\">Subscription Alert</h4>\r\n                </div>\r\n                <div class=\"modal-body\" id=\"renewPlanBody\" style=\"height: 500px;\">\r\n                    <div class=\"row\" id=\"divExpireSubsStepOne\">\r\n                        <div class=\"col-md-12 text-center\">\r\n                            <h2>Your subscription is not Active.Please Active your subscription</h2>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"row\" id=\"divExpireSubsStepTwo\">\r\n                        <div class=\"col-md-4 text-right\">Your Current Plan</div>\r\n                        <div class=\"col-md-6 text-center\">\r\n                            <select id=\"ddlRenewPlan\" class=\"form-control\" disabled></select>\r\n                            <input type=\"hidden\" id=\"txtZohoSubscriptionId\" />\r\n                            <input type=\"hidden\" id=\"txtPlanCode\" />\r\n                            <input type=\"hidden\" id=\"txtZohoCustomerId\" />\r\n\r\n                            <input type=\"hidden\" id=\"txtSalesPersion\" />\r\n\r\n                        </div>\r\n                        <div class=\"col-md-12 text-center p-t-2\">\r\n                            <button type=\"button\" class=\"btn btn-default\" data-dismiss=\"modal\">Cancel</button>\r\n                            <button type=\"button\" class=\"btn btn-primary\" id=\"btnResubscribe\">Renew</button>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"row\" id=\"divExpireSubStepMsg\">\r\n\r\n                    </div>\r\n                </div>\r\n                <div class=\"modal-footer\">\r\n                    \r\n                </div>\r\n            </div>\r\n\r\n        </div>\r\n    </div>\r\n    <div id=\"ModalRenewSubscriptionNew\" class=\"modal fade\" role=\"dialog\">\r\n        <div class=\"modal-dialog\" style=\"height: auto;\">\r\n            <!-- Modal content-->\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <button type=\"button\" class=\"close\" data-dismiss=\"modal\">&times;</button>\r\n                    <h4 class=\"modal-title\">Subscription Alert</h4>\r\n                </div>\r\n                <div class=\"modal-body\" id=\"renewPlanBody\" style=\"height: auto;\">\r\n                    <input type=\"hidden\" id=\"txtSubscriptionIdNew\" />\r\n                    <input type=\"hidden\" id=\"txtCorporateAccountId\" />\r\n                    <div class=\"row\">\r\n                        <div class=\"col-md-12 text-center\">\r\n                            <h2 id=\"headerdue\" style=\"padding-bottom:10px;\">Your subscription payment is overdue. Please make payment using Hana Client Portal below.</h2>\r\n                            <h2 style=\"color:red;display:none;\" id=\"headerstilldue\">Your subscription is still overdue. Please make payment using the link below before proceeding.</h2>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"row\">\r\n                        <div class=\"col-md-4 text-right\"><h3>Client Portal:</h3></div>\r\n                        <div class=\"col-md-8\"> <h3><a id=\"btnSubscriptionLink\" href=\"https://hanafloralpos3.com/Account/SAMLUserLogin?Email=aGFuYXBvc3FhdGVhbUBnbWFpbC5jb20=\" style=\"cursor:pointer;\" target=\"_blank\">Click here to Make Payment</a></h3></div>\r\n                        <div class=\"col-md-4 text-right\"><h3>Your Login Email:</h3></div>\r\n                        <div class=\"col-md-8\"><h3><span id=\"ZohoEmailId\"></span></h3></div>\r\n                        <div class=\"col-md-4 text-right\"><h3>Already Paid?:</h3></div>\r\n                        <div class=\"col-md-8\"><h3><a id=\"lnkAlreadyPaid\" style=\"cursor:pointer;\" onclick=\"CheckSubscriptionStatus()\">Click here if you already made payment online.</a></h3></div>\r\n                    </div>\r\n                    <!-- Account Balance Display Section -->\r\n                    <div id=\"AccountBalanceDisplay\" style=\"display:none;\"></div>\r\n                    <div class=\"row\">\r\n                        <div class=\"col-md-12 text-center\">\r\n                            <b><span id=\"ErrorMsg\" style=\"color:red;\"></span></b>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"modal-footer\">\r\n                    \r\n                    <div class=\"row\">\r\n                        <h3 class=\"col-md-12 text-center\" style=\"color:red;line-height:normal\">It typically takes 15 minutes after payment before it is reflected in Hana. Please wait at least 15 mins after payment before you try to login.</h3>\r\n                    </div>\r\n                    \r\n                    \r\n                </div>\r\n            </div>\r\n\r\n        </div>\r\n    </div>\r\n   \r\n\r\n\r\n\r\n\r\n\r\n\r\n    <script src=\"/Scripts/jquery-3.6.4.min.js\" type=\"text/javascript\"></script>\r\n    <script src=\"/js-new/bootstrap.min.js\"></script>\r\n    <script src=\"/Scripts/custom/Default.js?dev=072619\"></script>\r\n    <script src=\"/Scripts/plugins/toastr/toastr.min.js\"></script>\r\n    <script type=\"text/javascript\">localStorage.setItem(\"IsLogin\", \"No\");</script>\r\n    <script type='text/javascript' src='/Scripts/Static/Constant.js?v=1116145234'></script>;\r\n    <script type='text/javascript' src='/Scripts/custom/Login.js?v=1116145234'></script>\r\n    <script type='text/javascript' src='/Scripts/custom/_LayoutHana/_CommonMethods.js?v=1116145234'></script>\r\n\r\n    <script type=\"text/javascript\">\r\n        let mfaTimer;\r\n        let timeLeft = 300;\r\n        function ShowMfaModal() {\r\n            $(document).ready(function() {\r\n                $('#mfaModal').modal('show');\r\n                startMfaTimer();\r\n                setupOtpInputs();\r\n\r\n            });\r\n        }\r\n\r\n        function startMfaTimer() {\r\n            if (mfaTimer) {\r\n                clearInterval(mfaTimer);\r\n                mfaTimer = null;\r\n            }\r\n            timeLeft = 300;\r\n            updateTimerDisplay();\r\n\r\n            mfaTimer = setInterval(function() {\r\n                timeLeft--;\r\n                if (timeLeft <= 0) {\r\n                    timeLeft = 0;\r\n                    updateTimerDisplay();\r\n                    clearInterval(mfaTimer);\r\n                    mfaTimer = null;\r\n                    showMfaError('Verification code has expired. Please request a new code.');\r\n                    const verifyBtn = document.getElementById('verifyMfaCode');\r\n                    if (verifyBtn) {\r\n                        verifyBtn.disabled = true;\r\n                    }\r\n                    // Hide the timer when expired\r\n                    const timerElement = document.getElementById('mfaTimer');\r\n                    if (timerElement) {\r\n                        timerElement.parentElement.style.display = 'none';\r\n                    }\r\n                    return;\r\n                }\r\n                updateTimerDisplay();\r\n            }, 1000);\r\n        }\r\n\r\n        function updateTimerDisplay() {\r\n            const safeTime = Math.max(0, timeLeft);\r\n            const minutes = Math.floor(safeTime / 60);\r\n            const seconds = safeTime % 60;\r\n            const timerElement = document.getElementById('mfaTimer');\r\n            if (timerElement) {\r\n                timerElement.textContent = minutes + ':' + (seconds < 10 ? '0' : '') + seconds;\r\n            }\r\n        }\r\n\r\n        function setupOtpInputs() {\r\n            const inputs = document.querySelectorAll('.otp-input');\r\n\r\n            inputs.forEach((input, index) => {\r\n                input.addEventListener('input', function(e) {\r\n                    this.value = this.value.replace(/[^0-9]/g, '');\r\n\r\n                    if (this.value.length === 1 && index < inputs.length - 1) {\r\n                        inputs[index + 1].focus();\r\n                    }\r\n\r\n                    this.classList.remove('error');\r\n                    hideMfaError();\r\n                });\r\n\r\n                input.addEventListener('keydown', function(e) {\r\n                    if (e.key === 'Backspace' && this.value === '' && index > 0) {\r\n                        inputs[index - 1].focus();\r\n                    }\r\n\r\n                    if (e.key === 'Enter') {\r\n                        if (index === inputs.length - 1) {\r\n                            verifyMfaCode();\r\n                        } else {\r\n                            inputs[index + 1].focus();\r\n                        }\r\n                    }\r\n                });\r\n\r\n                input.addEventListener('paste', function(e) {\r\n                    e.preventDefault();\r\n                    const paste = (e.clipboardData || window.clipboardData).getData('text');\r\n                    const numbers = paste.replace(/[^0-9]/g, '').substring(0, 6);\r\n\r\n                    inputs.forEach((inp, i) => {\r\n                        inp.value = numbers[i] || '';\r\n                    });\r\n\r\n                    if (numbers.length === 6) {\r\n                        verifyMfaCode();\r\n                    }\r\n                });\r\n            });\r\n\r\n            if (inputs.length > 0) {\r\n                inputs[0].focus();\r\n            }\r\n        }\r\n\r\n        function getOtpValue() {\r\n            const inputs = document.querySelectorAll('.otp-input');\r\n            let otp = '';\r\n            inputs.forEach(input => {\r\n                otp += input.value;\r\n            });\r\n            return otp;\r\n        }\r\n\r\n        function clearOtpInputs() {\r\n            const inputs = document.querySelectorAll('.otp-input');\r\n            inputs.forEach(input => {\r\n                input.value = '';\r\n                input.classList.remove('error');\r\n            });\r\n            if (inputs.length > 0) {\r\n                inputs[0].focus();\r\n            }\r\n        }\r\n\r\n        function showMfaError(message) {\r\n            const errorElement = document.getElementById('mfaError');\r\n            const successElement = document.getElementById('mfaSuccess');\r\n\r\n            if (errorElement) {\r\n                errorElement.textContent = message;\r\n                errorElement.style.display = 'block';\r\n            }\r\n            if (successElement) {\r\n                successElement.style.display = 'none';\r\n            }\r\n\r\n            document.querySelectorAll('.otp-input').forEach(input => {\r\n                input.classList.add('error');\r\n            });\r\n        }\r\n\r\n        function showMfaSuccess(message) {\r\n            const successElement = document.getElementById('mfaSuccess');\r\n            const errorElement = document.getElementById('mfaError');\r\n\r\n            if (successElement) {\r\n                successElement.textContent = message;\r\n                successElement.style.display = 'block';\r\n            }\r\n            if (errorElement) {\r\n                errorElement.style.display = 'none';\r\n            }\r\n        }\r\n\r\n        function hideMfaError() {\r\n            const errorElement = document.getElementById('mfaError');\r\n            if (errorElement) {\r\n                errorElement.style.display = 'none';\r\n            }\r\n        }\r\n\r\n        function verifyMfaCode() {\r\n            const otpCode = getOtpValue();\r\n            const trust = document.getElementById('trustDevice') && document.getElementById('trustDevice').checked;\r\n\r\n            if (otpCode.length !== 6) {\r\n                showMfaError('Please enter all 6 digits.');\r\n                return;\r\n            }\r\n\r\n            const verifyBtn = document.getElementById('verifyMfaCode');\r\n            const originalText = verifyBtn.innerHTML;\r\n            verifyBtn.disabled = true;\r\n            verifyBtn.innerHTML = '<i class=\"fa fa-spinner fa-spin\"></i> Verifying...';\r\n\r\n            $.ajax({\r\n                url: '/Account/ValidateMfaOtp',\r\n                type: 'POST',\r\n                data: {\r\n                    otpCode: otpCode,\r\n                    trustDevice: trust,\r\n                    __RequestVerificationToken: $('input[name=\"__RequestVerificationToken\"]').val()\r\n                },\r\n                success: function(response) {\r\n                    if (response.IsSuccess) {\r\n                        showMfaSuccess(response.Message);\r\n                        clearInterval(mfaTimer);\r\n\r\n                        setTimeout(function () {\r\n                            if (typeof GetCommonData === 'function') {\r\n                                GetCommonData();\r\n                            } else {\r\n                                window.location.href = response.RedirectUrl;\r\n                            }\r\n                        }, 300);\r\n                    } else {\r\n                        showMfaError(response.Message);\r\n                        clearOtpInputs();\r\n                    }\r\n                },\r\n                error: function() {\r\n                    showMfaError('Verification failed. Please try again.');\r\n                    clearOtpInputs();\r\n                },\r\n                complete: function() {\r\n                    verifyBtn.disabled = false;\r\n                    verifyBtn.innerHTML = originalText;\r\n                }\r\n            });\r\n        }\r\n\r\n        function resendMfaCode() {\r\n            const resendBtn = document.getElementById('resendMfaCode');\r\n            const originalText = resendBtn.innerHTML;\r\n            const verifyBtn = document.getElementById('verifyMfaCode');\r\n            if (window._mfaResendInterval) {\r\n                clearInterval(window._mfaResendInterval);\r\n                window._mfaResendInterval = null;\r\n            }\r\n\r\n            resendBtn.disabled = true;\r\n            resendBtn.innerHTML = '<i class=\"fa fa-spinner fa-spin\"></i> Sending...';\r\n\r\n            $.ajax({\r\n                url: '/Account/ResendMfaOtp',\r\n                type: 'POST',\r\n                success: function(response) {\r\n                    if (response.IsSuccess) {\r\n                        showMfaSuccess(response.Message);\r\n                        clearOtpInputs();\r\n                        (function(){\r\n                            var timerEl = document.getElementById('mfaTimer');\r\n                            if (timerEl && timerEl.parentElement) {\r\n                                timerEl.parentElement.style.display = '';\r\n                            }\r\n                        })();\r\n                        startMfaTimer();\r\n                        if (verifyBtn) verifyBtn.disabled = false;\r\n                        let cooldown = 30;\r\n                        resendBtn.innerHTML = 'Resend in ' + cooldown + 's';\r\n                        window._mfaResendInterval = setInterval(function () {\r\n                            cooldown--;\r\n                            if (cooldown <= 0) {\r\n                                clearInterval(window._mfaResendInterval);\r\n                                window._mfaResendInterval = null;\r\n                                resendBtn.disabled = false;\r\n                                resendBtn.innerHTML = originalText;\r\n                            } else {\r\n                                resendBtn.innerHTML = 'Resend in ' + cooldown + 's';\r\n                            }\r\n                        }, 1000);\r\n                    } else {\r\n                        showMfaError(response.Message);\r\n                        resendBtn.disabled = false;\r\n                        resendBtn.innerHTML = originalText;\r\n                    }\r\n                },\r\n                error: function() {\r\n                    showMfaError('Failed to resend code. Please try again.');\r\n                    resendBtn.disabled = false;\r\n                    resendBtn.innerHTML = originalText;\r\n                }\r\n            });\r\n        }\r\n\r\nGetCommonData()\r\n    </script>\r\n\r\n\r\n    <script>\r\n        function openCity(evt, cityName) {\r\n            var i, ltabcontent, ltablinks;\r\n            ltabcontent = document.getElementsByClassName(\"ltabcontent\");\r\n            for (i = 0; i < ltabcontent.length; i++) {\r\n                ltabcontent[i].style.display = \"none\";\r\n            }\r\n            ltablinks = document.getElementsByClassName(\"ltablinks\");\r\n            for (i = 0; i < ltablinks.length; i++) {\r\n                ltablinks[i].className = ltablinks[i].className.replace(\" active\", \"\");\r\n            }\r\n            document.getElementById(cityName).style.display = \"block\";\r\n            evt.currentTarget.className += \" active\";\r\n\r\n            // Added by Yuganraj B for #280351 on 07-Apr-2025\r\n            let redirectMap = {\r\n                'delivery': ' https://www.hanafloristpos.com/features/delivery-tracking/',\r\n                'paperless': ' https://www.hanafloristpos.com/features/paperless-billing/',\r\n                'security': ' https://www.hanafloristpos.com/features/integrated-credit-card-payments/',\r\n                'implementation': ' https://www.hanafloristpos.com/features/easy-to-adopt/',\r\n                'email': 'https://www.hanafloristpos.com/features/email-marketing/'\r\n            };\r\n\r\n            if (redirectMap[cityName]) {\r\n                window.open(redirectMap[cityName], '_blank');\r\n                //window.location.href = redirectMap[cityName]; // To open is same Tab\r\n            }\r\n            //End for #280351 on 07-Apr-2025\r\n        }\r\n\r\n        // Get the element with id=\"defaultOpen\" and click on it\r\n        document.getElementById(\"defaultOpen\").click();\r\n    </script>\r\n\r\n    <!-- MFA Verification Modal -->\r\n    <div id=\"mfaModal\" class=\"modal fade\" role=\"dialog\" data-backdrop=\"static\" data-keyboard=\"false\">\r\n        <div class=\"modal-dialog modal-dialog-centered mfa-modal-dialog\">\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <h4 class=\"modal-title\">\r\n                        <i class=\"fa fa-shield\" style=\"color: #007bff;\"></i>\r\n                        Verify Your Identity\r\n                    </h4>\r\n                </div>\r\n                <div class=\"modal-body text-center\">\r\n                    <p class=\"mb-3\">We've sent a 6-digit verification code to:</p>\r\n                    <p class=\"font-weight-bold text-primary\" id=\"maskedEmail\"></p>\r\n                    <p class=\"mb-4\">Enter the code below to complete your login:</p>\r\n\r\n                    <div class=\"otp-container mb-3\">\r\n                        <input type=\"text\" class=\"otp-input\" maxlength=\"1\" id=\"otp1\" />\r\n                        <input type=\"text\" class=\"otp-input\" maxlength=\"1\" id=\"otp2\" />\r\n                        <input type=\"text\" class=\"otp-input\" maxlength=\"1\" id=\"otp3\" />\r\n                        <input type=\"text\" class=\"otp-input\" maxlength=\"1\" id=\"otp4\" />\r\n                        <input type=\"text\" class=\"otp-input\" maxlength=\"1\" id=\"otp5\" />\r\n                        <input type=\"text\" class=\"otp-input\" maxlength=\"1\" id=\"otp6\" />\r\n                    </div>\r\n\r\n                    <div id=\"mfaError\" class=\"alert alert-danger\" style=\"display: none;\"></div>\r\n                    <div id=\"mfaSuccess\" class=\"alert alert-success\" style=\"display: none;\"></div>\r\n\r\n                    <div class=\"mb-3\">\r\n                        <p class=\"text-muted small\">Code expires in <span id=\"mfaTimer\">5:00</span></p>\r\n                    </div>\r\n\r\n                    <div class=\"trust-device-container hidden-xs hidden-sm\">\r\n                        <div class=\"form-check\">\r\n                            <input type=\"checkbox\" class=\"form-check-input\" id=\"trustDevice\" />\r\n                            <label class=\"form-check-label\" for=\"trustDevice\">\r\n                                Trust this device for 30 days\r\n                            </label>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"modal-footer mfa-modal-footer\">\r\n                    <div class=\"pull-left hidden-md hidden-lg\" style=\"margin-right:auto; display:flex; align-items:center; gap:8px;\">\r\n                        <input type=\"checkbox\" id=\"trustDevice\" />\r\n                        <label for=\"trustDevice\" style=\"margin:0; font-weight:normal;\">Trust this device for 30 days</label>\r\n                    </div>\r\n                    <div class=\"mfa-footer-actions\">\r\n                        <button type=\"button\" class=\"btn btn-secondary\" id=\"resendMfaCode\">\r\n                            <i class=\"fa fa-refresh\"></i> <span class=\"btn-text\">Resend Code</span>\r\n                        </button>\r\n                        <button type=\"button\" class=\"btn btn-primary\" id=\"verifyMfaCode\">\r\n                            <i class=\"fa fa-check\"></i> <span class=\"btn-text\">Verify</span>\r\n                        </button>\r\n                        <button type=\"button\" class=\"btn btn-link\" onclick=\"window.location.reload();\"><span class=\"btn-text\">Cancel</span></button>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n\r\n    <script>\r\n        $(document).ready(function () {\r\n            $('#verifyMfaCode').on('click', verifyMfaCode);\r\n            $('#resendMfaCode').on('click', resendMfaCode);\r\n\r\n            try {\r\n                var hasCookie = document.cookie.split('; ').some(function (c) { return c.indexOf('Hana_MFA_Trust=') === 0; }); \r\n                var stored = localStorage.getItem('Hana_MFA_Trust');\r\n                if (!hasCookie && stored) {\r\n                   document.cookie = 'Hana_MFA_Trust=' + encodeURIComponent(stored) + '; Path=/; SameSite=None; Secure';\r\n                   \r\n                }\r\n            } catch (e) { }\r\n\r\n            $('form').on('submit', function (e) {\r\n                try {\r\n                    var hasCookie = document.cookie.split('; ').some(function (c) { return c.indexOf('Hana_MFA_Trust=') === 0; });\r\n                    var storedToken = localStorage.getItem('Hana_MFA_Trust');\r\n                    if (!hasCookie && storedToken) {\r\n                        $('#hdnMfaTrustToken').val(storedToken);\r\n                    }\r\n                } catch (e) {\r\n                }\r\n            });\r\n\r\n            $(\"#btnLogin\").click(function (e) {\r\n                const pwd = document.getElementById(\"Password\");\r\n                pwd.value = btoa(pwd.value);\r\n            });\r\n\r\n        });\r\n    </script>\r\n    \r\n    <script type=\"text/javascript\">\r\n        (function () {\r\n            document.addEventListener('contextmenu', function (e) {\r\n                e.preventDefault();\r\n            });\r\n            document.addEventListener('keydown', function (e) {\r\n                if (e.key === 'F12' ||\r\n                    (e.ctrlKey && e.key === 'u') ||\r\n                    (e.ctrlKey && e.shiftKey && (e.key === 'I' || e.key === 'i' || e.key === 'J' || e.key === 'j')) ||\r\n                    (e.metaKey && e.altKey && e.key === 'u') ||\r\n                    (e.metaKey && e.altKey && (e.key === 'I' || e.key === 'i' || e.key === 'J' || e.key === 'j'))) {\r\n                    e.preventDefault();\r\n                }\r\n            });\r\n        })();\r\n    </script>\r\n</body>\r\n</html>"
